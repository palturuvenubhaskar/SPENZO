<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window background so launching in dark mode does not flash white
         before Compose draws its first frame. -->
    <style name="Theme.Spenzo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF090A0F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
